<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="brand_report_wizard" model="ir.ui.view">
        <field name="name">Sales Report brand Wise</field>
        <field name="model">sales.report.brand</field>
        <field name="arch" type="xml">
            <form string="Sales Report Brand Wise">
                <group>
                    <group>
                        <field name="from_date"/>
                        <field name="brand" />
                        <field name="sales_type"/>
                    </group>
                    
                    <group>
                        <field name="to_date"/>
                        <field name="store_ids" widget="many2many_tags"/>
                    </group>

                </group> 
                <footer>
                    <button name="print_report_word" type="object" string="Print PDF" class="oe_highlight"/>
                    <button name="print_report_excel" type="object" string="Print Excel" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="brand_report_action" model="ir.actions.act_window">
        <field name="name">Sales Report Brand Wise</field>
        <field name="res_model">sales.report.brand</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="brand_report_menu"
            name="Sales Report Brand Wise"
            parent="sale.menu_sale_report"
            action="brand_report_action"
            sequence="50"
/>  
</odoo>