<odoo>
    <template id="invoicing_custom_report_template">
        <t t-call="web.basic_layout">
            <div class="page">
                <h2>Invoicing Summary Report</h2>
                <p>
                    <strong>From:</strong> <t t-esc="str(others['date_from'])"/> -
                    <strong>To:</strong> <t t-esc="str(others['date_to'])"/>
                </p>

                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>S. #</th>
                            <th>Inv Date</th>
                            <th>Inv #</th>
                            <th>Item Name</th>
                            <th>Qty</th>
                            <th>Exclusive Amount</th>
                            <th>S.Tax</th>
                            <th>Further Tax</th>
                            <th>Adv. Tax</th>
                            <th>Inclusive Amount</th>
                            <th>Discount</th>
                            <th>Net Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="counter" t-value="1"/>
                        <t t-foreach="data" t-as="line">
                            <tr>
                                <td><t t-esc="line['s_no']"/></td>
                                <td><t t-esc="line['inv_date']"/></td>
                                <td><t t-esc="line['inv_number']"/></td>
                                <td><t t-esc="line['product_name']"/></td>
                                <td class="text-right"><t t-esc="line['quantity']"/></td>
                                <td class="text-right"><t t-esc="line['exclusive_amount']"/></td>
                                <td class="text-right"><t t-esc="line['s_tax']"/></td>
                                <td class="text-right"><t t-esc="line['further_tax']"/></td>
                                <td class="text-right"><t t-esc="line['adv_tax']"/></td>
                                <td class="text-right"><t t-esc="line['inclusive_amount']"/></td>
                                <td class="text-right"><t t-esc="line['discount']"/></td>
                                <td class="text-right"><t t-esc="line['net_amount']"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>
