<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="invoicing_custom_report_wizard" model="ir.ui.view">
        <field name="name">Invoicing Custom Report</field>
        <field name="model">invoicing.custom.report</field>
        <field name="arch" type="xml">
            <form string="Invoicing Custom Report">
                <group>
                    <group>
                        <field name="from_date"/>
                        <field name="to_date"/>
                    </group>

                </group> 
                <footer>
                    <button name="print_report_word" type="object" string="Print PDF" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="invoicing_custom_report_action" model="ir.actions.act_window">
        <field name="name">Invoicing Custom Report</field>
        <field name="res_model">invoicing.custom.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


<!-- From menu -->

    <menuitem id="invoicing_custom_report_menu"
            name="Sales Report"
            parent="sale.menu_sale_report"
            action="invoicing_custom_report_action"
            sequence="50"
/>  

