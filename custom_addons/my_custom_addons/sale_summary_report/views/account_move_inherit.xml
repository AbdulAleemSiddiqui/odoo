<odoo>
    <data>
        <!-- Add a Print Sales Summary button to invoice form header -->
        <record id="account_move_form_action_print_sales_summary" model="ir.ui.view">
            <field name="name">account.move.form.inherit.print.sales.summary</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="%(sale_summary_report.action_sale_summary_report)d" type="action" string="Print Sales Summary" class="oe_highlight"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>